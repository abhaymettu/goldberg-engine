{
  "name": "goldberg-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic headless physics for agent-built chain-reaction machines (Ring the Bell, The Tune Machine).",
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "goldberg-sim": "bin/sim.js",
    "goldberg-reel": "bin/reel.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/",
    "sim": "node bin/sim.js",
    "reel": "node bin/reel.js",
    "record": "node scripts/record.js",
    "docs": "node bin/schema-doc.js --write"
  },
  "license": "MIT",
  "devDependencies": {
    "playwright-core": "^1.64.1"
  }
}
